# ============================================================
# AI Service Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- AI Models ---
PRIMARY_MODEL=gemini-2.5-flash
CHEAP_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- API Keys ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/giao_an_db
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Pipeline Config ---
MAX_ITERATIONS=2
RAG_TOP_K=5
RAG_VECTOR_CANDIDATES=20
RAG_MIN_SCORE=0.35
RAG_DIVERSITY_PER_SOURCE=2
MAX_FILE_SIZE_DIRECT=2000

# --- Raw RAG Indexing ---
RAW_RAG_AUTO_INDEX=true
# Leave empty to use ../data/raw from the repo root.
RAW_RAG_DATA_DIR=
# Set to 0 to run only once on startup.
RAW_RAG_INDEX_INTERVAL_SECONDS=600
RAW_RAG_CHUNK_SIZE=2500
RAW_RAG_CHUNK_OVERLAP=250
RAW_RAG_CHUNK_VERSION=heading-v1
RAW_RAG_INDEX_MAINTENANCE_WORK_MEM=128MB

# --- Tracing ---
LANGSMITH_PROJECT=giao-an-thong-minh
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=giao-an-thong-minh

# --- Server ---
HOST=0.0.0.0
PORT=8000
