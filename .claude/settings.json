{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_TOOL_NAME=claude python scripts/log_hook.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_TOOL_NAME=claude python scripts/log_hook.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_TOOL_NAME=claude python scripts/log_hook.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
